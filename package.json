{
  "name": "sprite-generate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "图标标准化、版本化雪碧图生成及地图/普通页面复用示例",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "check": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "ol": "^10.6.1",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.19.0"
}
